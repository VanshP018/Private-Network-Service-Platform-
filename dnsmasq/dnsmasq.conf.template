# dnsmasq config template for Mac 1 (Private DNS Server)
#
# HOW TO USE:
#   1. Fill in team/team.env with real IPs first.
#   2. Replace <MAC1_IP> and <MAC2_IP> and teamX below.
#   3. Copy this file's contents into:
#      /opt/homebrew/etc/dnsmasq.conf
#   4. Start the service: sudo brew services start dnsmasq

# Private domain records - point both at Mac 2 (the edge/nginx machine)
address=/app.teamX.test/<MAC2_IP>
address=/api.teamX.test/<MAC2_IP>

# Only listen on localhost and the LAN interface (not the whole internet)
listen-address=127.0.0.1,<MAC1_IP>

# Don't forward to /etc/resolv.conf or poll it for changes -
# this server should ONLY answer for our private test domain.
# (If you also want it to resolve normal internet domains for convenience,
# comment out no-resolv and it will fall back to your normal DNS.)
no-resolv
no-poll

# Optional: short TTL for Phase 2, Extension B (DNS TTL demo)
# local-ttl=30
